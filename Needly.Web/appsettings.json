{
  "ConnectionStrings": {
    "Needly": "Data Source=needly.db"
  },
  "GitHubApp": {
    "Enabled": false,
    "AppSlug": "",
    "WebhookMaxPayloadBytes": 1048576,
    "WebhookQueueCapacity": 1024,
    "WebhookMaxAttempts": 5
  },
  "GitHubActions": {
    "RequiredApprovals": 1
  },
  "ActionRisk": {
    "ReviewWaitingThreshold": "08:00:00",
    "InactivityThreshold": "3.00:00:00",
    "EvaluationInterval": "00:15:00"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
