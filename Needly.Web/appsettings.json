{
  "ConnectionStrings": {
    "Needly": "Server=(localdb)\\MSSQLLocalDB;Database=Needly;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "GitHubApp": {
    "Enabled": false,
    "AppSlug": "",
    "WebhookMaxPayloadBytes": 1048576,
    "WebhookQueueCapacity": 1024,
    "WebhookMaxAttempts": 5
  },
  "GitHubActions": {
    "RequiredApprovals": 1
  },
  "GitHubHistoricalBootstrap": {
    "Enabled": true,
    "MaxRepositoriesPerBatch": 25,
    "MaxPagesPerEndpoint": 10,
    "ClaimTimeout": "00:15:00",
    "BatchInterval": "00:00:30"
  },
  "ActionRisk": {
    "ReviewWaitingThreshold": "08:00:00",
    "InactivityThreshold": "3.00:00:00",
    "EvaluationInterval": "00:15:00"
  },
  "FollowUp": {
    "StaleFeedbackThreshold": "2.00:00:00",
    "EvaluationInterval": "00:15:00"
  },
  "Decide": {
    "Labels": [ "needs-decision", "question", "rfc", "discussion" ]
  },
  "ReviewRisk": {
    "LargeDiffChangedLines": 500
  },
  "AgentDetection": {
    "Rules": [
      {
        "Key": "dependabot",
        "DisplayName": "Dependabot",
        "LoginEquals": [ "dependabot[bot]" ],
        "AppSlugEquals": [ "dependabot" ]
      },
      {
        "Key": "renovate",
        "DisplayName": "Renovate",
        "LoginEquals": [ "renovate[bot]" ],
        "AppSlugEquals": [ "renovate" ]
      },
      {
        "Key": "github-copilot",
        "DisplayName": "GitHub Copilot",
        "LoginEquals": [ "copilot-swe-agent[bot]", "copilot[bot]" ],
        "AppSlugEquals": [ "copilot-swe-agent", "copilot" ]
      },
      {
        "Key": "devin",
        "DisplayName": "Devin",
        "LoginEquals": [ "devin-ai-integration[bot]" ],
        "AppSlugEquals": [ "devin-ai-integration" ]
      },
      {
        "Key": "claude-code",
        "DisplayName": "Claude Code",
        "LoginEquals": [ "claude[bot]" ],
        "LoginEndsWith": [ "-claude[bot]" ],
        "AppSlugEquals": [ "claude" ]
      },
      {
        "Key": "codex",
        "DisplayName": "Codex",
        "LoginEquals": [ "chatgpt-codex-connector[bot]" ],
        "AppSlugEquals": [ "chatgpt-codex-connector" ]
      },
      {
        "Key": "cursor",
        "DisplayName": "Cursor",
        "LoginEquals": [ "cursor[bot]", "cursoragent[bot]" ],
        "AppSlugEquals": [ "cursor" ]
      }
    ],
    "OtherBotKey": "other-bot",
    "OtherBotDisplayName": "Other bot"
  },
  "AttentionScore": {
    "AtRiskBonus": 20,
    "PinnedBonus": 15,
    "DirectAssignmentBonus": 10,
    "DraftPenalty": -15,
    "LargeDiffBonus": 5,
    "UrgentLabelBonus": 15,
    "UrgentLabels": [ "urgent", "critical", "security", "hotfix" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
