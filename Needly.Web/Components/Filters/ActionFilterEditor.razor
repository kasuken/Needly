<div class="action-filter-editor">
    <MudSelect T="ActionType?" Label="Type" Dense="true" Clearable="true"
               Value="@_type" ValueChanged="SetTypeAsync">
        @foreach (var type in Enum.GetValues<ActionType>())
        {
            <MudSelectItem T="ActionType?" Value="@type">@Format(type)</MudSelectItem>
        }
    </MudSelect>
    <MudSelect T="ActionState?" Label="State" Dense="true" Clearable="true"
               Value="@_state" ValueChanged="SetStateAsync">
        @foreach (var state in Enum.GetValues<ActionState>())
        {
            <MudSelectItem T="ActionState?" Value="@state">@Format(state)</MudSelectItem>
        }
    </MudSelect>
    <MudSelect T="ActionAssigneeScope" Label="Assignee" Dense="true"
               Value="@_scope" ValueChanged="SetScopeAsync">
        <MudSelectItem Value="ActionAssigneeScope.Any">Anyone visible</MudSelectItem>
        <MudSelectItem Value="ActionAssigneeScope.Me">Me</MudSelectItem>
        <MudSelectItem Value="ActionAssigneeScope.MyTeam">My team</MudSelectItem>
    </MudSelect>
    <MudSelect T="BotInvolvementFilter" Label="Bots" Dense="true"
               Value="@_bots" ValueChanged="SetBotsAsync">
        <MudSelectItem Value="BotInvolvementFilter.Any">Any</MudSelectItem>
        <MudSelectItem Value="BotInvolvementFilter.OnlyBots">Involved</MudSelectItem>
        <MudSelectItem Value="BotInvolvementFilter.ExcludeBots">Excluded</MudSelectItem>
    </MudSelect>
        <MudTextField T="string" Label="Repository" Placeholder="owner/name" Immediate="true"
                  Value="@_repository" ValueChanged="SetRepositoryAsync"/>
        <MudTextField T="string" Label="Organization" Placeholder="owner" Immediate="true"
                  Value="@_organization" ValueChanged="SetOrganizationAsync"/>
        <MudTextField T="string" Label="Author" Placeholder="login" Immediate="true"
                  Value="@_author" ValueChanged="SetAuthorAsync"/>
    <MudNumericField T="double?" Label="Waiting hours" Min="0.1"
                     Value="@_waitingHours" ValueChanged="SetWaitingAsync"/>
    @* Schema version 2 additions (issue #32). *@
    <MudTextField T="string" Label="Label" Placeholder="bug" Immediate="true"
                  Value="@_label" ValueChanged="SetLabelAsync"/>
    <MudSelect T="DraftFilter" Label="Draft" Dense="true"
               Value="@_draft" ValueChanged="SetDraftAsync">
        <MudSelectItem Value="DraftFilter.Any">Any</MudSelectItem>
        <MudSelectItem Value="DraftFilter.OnlyDrafts">Only drafts</MudSelectItem>
        <MudSelectItem Value="DraftFilter.ExcludeDrafts">Exclude drafts</MudSelectItem>
    </MudSelect>
    <MudSelect T="ActionSizeBucket?" Label="Size" Dense="true" Clearable="true"
               Value="@_sizeBucket" ValueChanged="SetSizeBucketAsync">
        @foreach (var bucket in Enum.GetValues<ActionSizeBucket>())
        {
            <MudSelectItem T="ActionSizeBucket?" Value="@bucket">@bucket</MudSelectItem>
        }
    </MudSelect>
    <MudTextField T="string" Label="Milestone" Placeholder="v2" Immediate="true"
                  Value="@_milestone" ValueChanged="SetMilestoneAsync"/>
    <MudSelect T="CodeownersFilter" Label="Requested via CODEOWNERS" Dense="true"
               Value="@_codeowners" ValueChanged="SetCodeownersAsync">
        <MudSelectItem Value="CodeownersFilter.Any">Any</MudSelectItem>
        <MudSelectItem Value="CodeownersFilter.OnlyRequested">Only CODEOWNERS</MudSelectItem>
        <MudSelectItem Value="CodeownersFilter.ExcludeRequested">Exclude CODEOWNERS</MudSelectItem>
    </MudSelect>
    @* Schema version 3 additions (issue #35). *@
    <MudTextField T="string" Label="Agent author" Placeholder="dependabot" Immediate="true"
                  Value="@_agentAuthor" ValueChanged="SetAgentAuthorAsync"/>
    @* Schema version 4 addition: self-owned repositories. *@
    <MudSelect T="SelfOwnedRepositoryFilter" Label="Repository ownership" Dense="true"
               Value="@_selfOwned" ValueChanged="SetSelfOwnedAsync">
        <MudSelectItem Value="SelfOwnedRepositoryFilter.Any">Any</MudSelectItem>
        <MudSelectItem Value="SelfOwnedRepositoryFilter.OnlySelfOwned">Only my own repositories</MudSelectItem>
        <MudSelectItem Value="SelfOwnedRepositoryFilter.ExcludeSelfOwned">Exclude my own repositories</MudSelectItem>
    </MudSelect>
    @* Schema version 3 addition (issue #34). *@
    <MudSelect T="ReviewRiskLevel?" Label="Review risk" Dense="true" Clearable="true"
               Value="@_riskLevel" ValueChanged="SetRiskLevelAsync">
        @foreach (var level in Enum.GetValues<ReviewRiskLevel>())
        {
            <MudSelectItem T="ReviewRiskLevel?" Value="@level">@level</MudSelectItem>
        }
    </MudSelect>
</div>

@code {
    [Parameter] public ActionFilter Value { get; set; } = new();
    [Parameter] public EventCallback<ActionFilter> ValueChanged { get; set; }

    private ActionType? _type;
    private ActionState? _state;
    private ActionAssigneeScope _scope;
    private BotInvolvementFilter _bots;
    private string? _repository;
    private string? _organization;
    private string? _author;
    private double? _waitingHours;

    // Schema version 2 additions (issue #32).
    private string? _label;
    private DraftFilter _draft;
    private ActionSizeBucket? _sizeBucket;
    private string? _milestone;
    private CodeownersFilter _codeowners;

    // Schema version 3 additions (issue #35).
    private string? _agentAuthor;

    // Schema version 4 addition: self-owned repositories.
    private SelfOwnedRepositoryFilter _selfOwned;

    // Schema version 3 addition (issue #34).
    private ReviewRiskLevel? _riskLevel;

    protected override void OnParametersSet()
    {
        _type = Value.Types.FirstOrDefault() is var type && Value.Types.Length > 0 ? type : null;
        _state = Value.States.FirstOrDefault() is var state && Value.States.Length > 0 ? state : null;
        _scope = Value.AssigneeScope;
        _bots = Value.BotInvolvement;
        _repository = Value.Repositories.FirstOrDefault();
        _organization = Value.Organizations.FirstOrDefault();
        _author = Value.Authors.FirstOrDefault();
        _waitingHours = Value.WaitingAtLeast?.TotalHours;
        _label = Value.Labels.FirstOrDefault();
        _draft = Value.IsDraft;
        _sizeBucket = Value.SizeBuckets.FirstOrDefault() is var bucket && Value.SizeBuckets.Length > 0 ? bucket : null;
        _milestone = Value.Milestones.FirstOrDefault();
        _codeowners = Value.RequestedViaCodeowners;
        _agentAuthor = Value.AgentAuthors.FirstOrDefault();
        _riskLevel = Value.RiskLevels.FirstOrDefault() is var riskLevel && Value.RiskLevels.Length > 0 ? riskLevel : null;
        _selfOwned = Value.SelfOwnedRepository;
    }

    private Task SetTypeAsync(ActionType? value) { _type = value; return NotifyAsync(); }
    private Task SetStateAsync(ActionState? value) { _state = value; return NotifyAsync(); }
    private Task SetScopeAsync(ActionAssigneeScope value) { _scope = value; return NotifyAsync(); }
    private Task SetBotsAsync(BotInvolvementFilter value) { _bots = value; return NotifyAsync(); }
    private Task SetRepositoryAsync(string value) { _repository = value; return NotifyAsync(); }
    private Task SetOrganizationAsync(string value) { _organization = value; return NotifyAsync(); }
    private Task SetAuthorAsync(string value) { _author = value; return NotifyAsync(); }
    private Task SetWaitingAsync(double? value) { _waitingHours = value; return NotifyAsync(); }
    private Task SetLabelAsync(string value) { _label = value; return NotifyAsync(); }
    private Task SetDraftAsync(DraftFilter value) { _draft = value; return NotifyAsync(); }
    private Task SetSizeBucketAsync(ActionSizeBucket? value) { _sizeBucket = value; return NotifyAsync(); }
    private Task SetMilestoneAsync(string value) { _milestone = value; return NotifyAsync(); }
    private Task SetCodeownersAsync(CodeownersFilter value) { _codeowners = value; return NotifyAsync(); }
    private Task SetAgentAuthorAsync(string value) { _agentAuthor = value; return NotifyAsync(); }
    private Task SetRiskLevelAsync(ReviewRiskLevel? value) { _riskLevel = value; return NotifyAsync(); }
    private Task SetSelfOwnedAsync(SelfOwnedRepositoryFilter value) { _selfOwned = value; return NotifyAsync(); }

    private Task NotifyAsync() => ValueChanged.InvokeAsync(new ActionFilter
    {
        Types = _type is { } type ? [type] : [],
        States = _state is { } state ? [state] : [],
        Repositories = Values(_repository),
        Organizations = Values(_organization),
        Authors = Values(_author),
        AssigneeScope = _scope,
        WaitingAtLeast = _waitingHours > 0 ? TimeSpan.FromHours(_waitingHours.Value) : null,
        BotInvolvement = _bots,
        Labels = Values(_label),
        IsDraft = _draft,
        SizeBuckets = _sizeBucket is { } sizeBucket ? [sizeBucket] : [],
        Milestones = Values(_milestone),
        RequestedViaCodeowners = _codeowners,
        AgentAuthors = Values(_agentAuthor),
        RiskLevels = _riskLevel is { } riskLevel ? [riskLevel] : [],
        SelfOwnedRepository = _selfOwned
    });

    private static string[] Values(string? value) => string.IsNullOrWhiteSpace(value) ? [] : [value.Trim()];

    private static string Format<T>(T value) where T : Enum =>
        System.Text.RegularExpressions.Regex.Replace(value.ToString(), "([a-z])([A-Z])", "$1 $2");
}
